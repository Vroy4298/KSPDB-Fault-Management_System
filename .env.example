# ─────────────────────────────────────────────────────────────
# KSPDB Fault Management System — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=kspdb
POSTGRES_USER=kspdb_user
POSTGRES_PASSWORD=kspdb_pass

# ── Backend ───────────────────────────────────────────────────
NODE_ENV=development
BACKEND_PORT=3000

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_PORT=5173

# ── Groq AI (for NL incident summaries) ──────────────────────
# Get your key at: https://console.groq.com/keys
# If left empty, the AI summary feature is silently skipped.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# ── Localization tuning ───────────────────────────────────────
# How long (ms) before a silent pole is considered "possibly dark"
# 1200000 = 20 minutes (covers 15min interval + 45s jitter + buffer)
HEARTBEAT_TIMEOUT_MS=1200000

# How long (ms) to wait before raising a ticket after first dark signal
# Allows late messages to arrive; keep well under 120s target
DEBOUNCE_MS=20000
